# patient data (raw exports, clinical notes, the built 01NVa dataset): never commit
dataset/

# training runs, model weights, caches, logs
runs/
*.pth
*.log
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# environments and editors
venv/
env/
.venv/
.env
*.env
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
*.swp
*.swo
*.tmp
*.bak

# packaging
*.egg
*.egg-info/
dist/
build/

# archived data / outputs: kept on disk for reference, too large or not code
archive/legacy_data/
archive/legacy_outputs/
archive/notebooks/*.csv
archive/notebooks/*.dat
archive/notebooks/*.qrs

# reports/ and notebooks/ are committed on purpose so results can be read
# without rebuilding (regenerate with: bash scripts/build_report.sh 0)
